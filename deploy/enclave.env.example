# Variables del parent (facturae-signer-parent) — SIN secretos.
# Copiar a /etc/facturae-signer/enclave.env (systemd EnvironmentFile).

# CID del enclave (sale de nitro-cli run-enclave / describe-enclaves).
ENCLAVE_CID=16

# Puerto vsock en el que escucha el signer dentro del enclave
# (coincide con LISTEN=vsock:… de la imagen Dockerfile.enclave).
ENCLAVE_VSOCK_PORT=9000

# Puerto vsock por el que el enclave sale hacia la AEAT (relay CONNECT).
# "0" desactiva el relay.
RELAY_VSOCK_PORT=9001

# Dirección TCP que ve WordPress (la signing_url del plugin).
INBOUND_LISTEN=:8080

# Whitelist exacta host:puerto para el relay de salida (mTLS de extremo a
# extremo: el parent sólo retransmite bytes).
#ALLOWED_HOSTS=prewww1.aeat.es:443,www1.agenciatributaria.gob.es:443,prewww10.aeat.es:443,www10.agenciatributaria.gob.es:443
